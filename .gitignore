# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store

# AUT-4919: editor backup artifacts. Lineage sync commits with `git add -A`, so a
# stray backup sitting in the working tree gets committed wholesale (b102347
# tracked CHANGELOG.md.bak, 140KB, forever). scripts/sync-mobile.sh in the
# autobrain monorepo also refuses to copy these out of frontend/.
*.bak
*~
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
# AUT-4356: do not blanket-ignore ios/Flutter/ — Runner.xcodeproj references
# Flutter/Debug.xcconfig, Flutter/Release.xcconfig and Flutter/AppFrameworkInfo.plist
# as base configs/resources, so excluding the whole dir left the CI checkout
# without them ("Unable to open base configuration reference file
# .../ios/Flutter/Release.xcconfig"). Generated files are ignored by ios/.gitignore.
!/ios/Flutter/
!/ios/Flutter/Debug.xcconfig
!/ios/Flutter/Release.xcconfig
!/ios/Flutter/AppFrameworkInfo.plist
/ios/Runner/GeneratedPluginRegistrant.h
/ios/Runner/GeneratedPluginRegistrant.m
